{
  "manifest_version": 3,
  "version": "1.5",
  "name": "Word Editor",
  "description": "A free & easy-to-use word editor extension for your browser.",
  "homepage_url": "https://Pro-Bandey.github.io/Projects/?pro=DocEdit",

  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "48": "data/icons/48.png",
    "64": "data/icons/64.png",
    "128": "data/icons/128.png",
    "256": "data/icons/icon.png"
  },

  "action": {
    "default_title": "DocEdit",
    "default_icon": {
      "16": "data/icons/16.png",
      "32": "data/icons/32.png",
      "48": "data/icons/48.png",
      "64": "data/icons/64.png",
      "128": "data/icons/128.png",
      "256": "data/icons/icon.png"
    }
  },
  "permissions": ["storage", "downloads", "contextMenus"],

  "background": {
    "scripts": [
      "workers/config.js",
      "workers/chrome.js",
      "workers/runtime.js",
      "workers/common.js"
    ]
  },

  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0",
      "id": "docedit@pro-bandey.com"
    }
  }
}
